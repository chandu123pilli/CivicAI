# CivicAI Backend Environment Variables
PROJECT_NAME="CivicAI"
API_V1_STR="/api"
SECRET_KEY="civicai-super-secret-jwt-key-change-in-production-vortex-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, PostgreSQL / Supabase supported)
DATABASE_URL="sqlite:///./civicai.db"
# Example PostgreSQL / Supabase URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/civicai"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File Upload Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional: Google Gemini API Key
# If omitted or invalid, CivicAI uses its built-in local deterministic fallback classifier
GEMINI_API_KEY=""

# Duplicate Detection Settings
SIMILARITY_DISTANCE_KM=1.0
SIMILARITY_SCORE_THRESHOLD=0.50
